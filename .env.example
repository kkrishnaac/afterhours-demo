# Vite build settings for the Cloudflare (live form) build: `npm run build:cf`
# reads .env.cloudflare (gitignored). Both values are public by design: the
# Turnstile SITE key is meant to be in the page; the SECRET key never is.
#
# Local testing uses Cloudflare's published always-pass test site key:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_WALKTHROUGH_API=/api/walkthrough
VITE_TURNSTILE_SITE_KEY=
