{
  "name": "hara-facilities-cleaning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "favicons": "node scripts/favicons.mjs",
    "test": "vitest run",
    "build:cf": "vite build --mode cloudflare",
    "dev:worker": "npm run build:cf && wrangler d1 migrations apply DB --local && wrangler dev",
    "worker:dev": "wrangler dev --port 8787 --ip 127.0.0.1",
    "build:prod": "vite build --mode production-cf",
    "db:migrate": "wrangler d1 migrations apply DB --remote --env production",
    "deploy": "npm test && npm run build:prod && wrangler deploy --env production",
    "leads": "node scripts/leads.mjs leads",
    "data-request": "node scripts/leads.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "motion": "^13.5.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
}
